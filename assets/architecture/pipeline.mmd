graph LR
    classDef math fill:#B45309,stroke:#7C3D06,color:#fff
    classDef classical fill:#76B900,stroke:#4E7A00,color:#fff
    classDef quantum fill:#2563EB,stroke:#1D4ED8,color:#fff
    classDef backend fill:#6933FF,stroke:#4B21C2,color:#fff
    classDef ai fill:#0EA5E9,stroke:#0369A1,color:#fff
    classDef result fill:#DC2626,stroke:#991B1B,color:#fff
    classDef planned fill:transparent,stroke:#94A3B8,stroke-dasharray:5 4,color:#94A3B8

    R["📜 Ramanujan 1914<br/>1/π series"]:::math
    T["🧮 exact SymPy sums<br/>classical/ramanujan_series.py"]:::math
    A["🎯 known amplitude π/4<br/>not derived from the series"]:::quantum
    P["📐 committed protocol<br/>+ declared time budget"]:::backend

    subgraph gpu["one local GPU, one run — benchmarks/harness.py"]
        direction TB
        K["⚡ CUDA C++ kernel<br/>NVRTC · host fsum"]:::classical
        Q["⚛️ QAE circuit · CUDA-Q<br/>target from quantum/backend.py"]:::quantum
    end

    J["🗄️ run JSON · schema 5<br/>validated · never overwritten<br/>complete or aborted"]:::result
    F["📊 figures<br/>complete runs only"]:::result
    N["🤖 NIM · Nemotron<br/>optional prose draft"]:::ai
    H["👤 human review record<br/>hash-bound to draft + run"]:::ai

    G["🕸️ LPS Ramanujan graphs<br/>classical/ramanujan_graph.py"]:::math
    D["classical code + decoder study<br/>Phase 2 · planned"]:::planned
    C["H100 / multi-GPU<br/>planned · gated, unmeasured"]:::planned

    R --> K
    A --> Q
    T -.->|1e-15 integration check| K
    P --> gpu
    K --> J
    Q --> J
    J --> F
    J --> N
    N --> H
    F --> H
    G -.-> D
    gpu -.-> C

    style gpu fill:transparent,stroke:#76B900,stroke-width:2px,stroke-dasharray:6 3
